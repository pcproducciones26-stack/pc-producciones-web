DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Sitio
NEXT_PUBLIC_SITE_URL="https://www.pcproducciones.com.ar"

# Admin (generar el hash con: npm run admin:hash-password -- "tu-password")
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""
SESSION_SECRET=""

# Contacto
CONTACT_EMAIL_TO="info@pcproducciones.com.ar"
RESEND_API_KEY=""

# Instagram - seccion "Seguinos en Instagram" de la home: widget de terceros
# (id del widget de SnapWidget/Elfsight/LightWidget)
NEXT_PUBLIC_INSTAGRAM_WIDGET_ID=""

# Instagram - galeria propia gestionada desde /admin/instagram (no se usa en la
# home mientras este activo el widget de arriba, pero queda disponible).
# API oficial de Meta - developers.facebook.com > tu app > Instagram > API setup with Instagram login
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_REDIRECT_URI="https://www.pcproducciones.com.ar/api/admin/instagram/callback"

# Secreto compartido para autenticar los cron jobs de Vercel (cualquier string largo random)
CRON_SECRET=""

# Vercel Blob - subida del video del hero desde /admin/settings (se crea solo
# al conectar un Blob Store al proyecto en Vercel; copiar el valor generado)
BLOB_READ_WRITE_TOKEN=""

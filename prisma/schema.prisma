generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EventStatus {
  PUBLISHED
  DRAFT
}

model Event {
  id          String      @id @default(cuid())
  title       String
  date        DateTime
  venue       String
  imageUrl    String?
  ticketUrl   String
  description String?
  status      EventStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([date])
  @@index([status])
}

model PastShow {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  venue       String
  photoUrls   String[] @default([])
  videoUrls   String[] @default([])
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
}

model InstagramPost {
  id         String   @id @default(cuid())
  externalId String?  @unique
  imageUrl   String
  postUrl    String?
  caption    String?
  postedAt   DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([postedAt])
}

model InstagramConfig {
  id               String    @id @default("singleton")
  accessToken      String
  businessAccountId String
  tokenExpiresAt   DateTime?
  lastSyncedAt     DateTime?
  updatedAt        DateTime  @updatedAt
}

model SiteSettings {
  id             String   @id @default("singleton")
  heroVideoUrl   String?
  marqueeArtists String[] @default([])
  updatedAt      DateTime @updatedAt
}

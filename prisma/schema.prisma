generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EventStatus {
  PUBLISHED
  DRAFT
}

model Event {
  id          String      @id @default(cuid())
  title       String
  date        DateTime
  venue       String
  imageUrl    String?
  ticketUrl   String
  description String?
  status      EventStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([date])
  @@index([status])
}

model InstagramPost {
  id         String    @id @default(cuid())
  externalId String?   @unique
  imageUrl   String
  postUrl    String?
  caption    String?
  eventDate  DateTime?
  venue      String?
  city       String?
  postedAt   DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([postedAt])
}

model InstagramConfig {
  id               String    @id @default("singleton")
  accessToken      String
  businessAccountId String
  tokenExpiresAt   DateTime?
  lastSyncedAt     DateTime?
  updatedAt        DateTime  @updatedAt
}

model SiteSettings {
  id             String   @id @default("singleton")
  heroVideoUrl   String?
  heroTitle      String?
  heroSubtitle   String?
  heroCtaLabel   String?
  heroCtaUrl     String?
  marqueeArtists String[] @default([])
  aboutText      String?
  aboutAreas     String[] @default([])
  featuredTitle    String?
  featuredSubtitle String?
  updatedAt      DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

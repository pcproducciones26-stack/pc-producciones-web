generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EventStatus {
  PUBLISHED
  DRAFT
}

model Event {
  id          String      @id @default(cuid())
  title       String
  date        DateTime
  venue       String
  imageUrl    String?
  ticketUrl   String
  description String?
  status      EventStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([date])
  @@index([status])
}
